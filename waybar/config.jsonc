{
	"spacing": 15,
	"layer": "top",
	"position": "top",
	// "height": 0,
	"reload_style_on_change": true,
	"modules-left": [
		"custom/suspend",
		"mpris"
		// "mango/window"
	],

	"modules-center": ["hyprland/workspaces"],

	"modules-right": [
		// "group/expand",
		// "backlight",
		// "custom/cava",
		"network",
		"bluetooth",
		"cpu",
		"memory",
		"pulseaudio",
		// "pulseaudio#text",
		"battery",
		"clock"
	],
	// "cava": {
	// 	"input_delay": 2,
	// 	"actions": {
	// 		"on-click-right": "mode"
	// 	}
	// },
	"backlight/slider": {
		"min": 0,
		"max": 100,
		"orientation": "horizontal",
		"device": "intel_backlight"
	},

	// "custom/cava": {
	// 	"exec": "~/.config/waybar/scripts/cava.sh",
	// 	"exec-on-event": false,
	// 	"return-type": "json",
	// 	"escape": true,
	// 	"format": "{}",
	// 	"tooltip": false,
	// 	"on-click-right": "kitty cava"
	// },
	"mango/window": {
		"format": "{title}",
		"rewrite": {
			"(.*) - Mozilla Firefox": "🌎 $1",
			"(.*) - zsh": "> [$1]"
		},
		"icon": true,
		"icon-size": 18
	},
	"mango/workspaces": {
		"format": "{icon}",
		"format-icons": {
			"active": "",
			"default": "",
			"empty": ""
		},
		// "hide-empty": true,
		"on-click": "activate",
		"on-click-right": "toggle",
		"overview-label": "OVERVIEW"
		// "persistent-workspaces": {
		// 	"*": [1, 2, 3, 4, 5]
		// }
	},
	"pulseaudio": {
		"format": "{volume}% {icon}",
		// "format-bluetooth": "{volume}% {icon}",
		"format-muted": "",
		"format-icons": {
			"alsa_output.pci-0000_00_1f.3.analog-stereo": "",
			"alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
			"headset": "",
			"headphone": "",
			"hands-free": "󰂑",
			"phone": "",
			"phone-muted": "",
			"portable": "",
			"car": "",
			"default": ["", ""]
		},
		"scroll-step": 1,
		"on-click": "pavucontrol"
	},
	// "pulseaudio/slider#out": {
	// 	"min": 0,
	// 	"max": 100,
	// 	"orientation": "horizontal",
	// 	"zero-on-mute": false,
	// 	"unmute-on-volume-change": false
	// },
	// "pulseaudio/slider#in": {
	// 	"min": 0,
	// 	"max": 100,
	// 	"orientation": "horizontal",
	// 	"target": "source"
	// },

	"custom/suspend": {
		"tooltip": false,
		"format": " ⏾",
		"on-click": "systemctl suspend",
		"tooltip-format": "Suspend"
	},

	"custom/notification": {
		"tooltip": false,
		"format": "",
		"on-click": "swaync-client -t -sw",
		"escape": true
	},
	"clock": {
		"format": "{:%I:%M:%S %p} ",
		"interval": 1,
		"tooltip-format": "<tt>{calendar}</tt>",
		"calendar": {
			"format": {
				"today": "<span color='#fAfBfC'><b>{}</b></span>"
			}
		},
		"actions": {
			"on-click-right": "shift_down",
			"on-click": "shift_up"
		}
	},
	"network": {
		"format-wifi": "{signalStrength}% ",
		"format-ethernet": "",
		"format-disconnected": "WiFi-off",
		"tooltip-format-disconnected": "WiFi-off",
		"tooltip-format-wifi": "{essid} ({signalStrength}%) ",
		"tooltip-format-ethernet": "{ifname} 🖧 ",
		// "on-click": "rfkill toggle wifi",
		"on-click": "kitty  --app-id impala impala"
	},
	"bluetooth": {
		"format-on": "󰂯",
		"format-off": "BT-off",
		// "format-disabled": "󰂲",
		"format-connected-battery": "{device_battery_percentage}% 󰂯",
		// "format-alt": "{device_alias} 󰂯",
		"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
		"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}\n{device_address}",
		"tooltip-format-enumerate-connected-battery": "{device_alias}\n{device_address}\n{device_battery_percentage}%",
		// "on-lick": "kitty bluetui"
		// "on-click": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on",
		// "on-click-right": "kitty --class bluetui bluetui"
		//"on-click": "rfkill toggle bluetooth",
		"on-click": "kitty --app-id bluetui  bluetui"
	},
	"battery": {
		"interval": 30,
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 20
		},
		"format": "{capacity}% {icon}",
		"format-charging": "{capacity}% 󰂄",
		"format-plugged": "{capacity}% 󰂄 ",
		"format-alt": "{time} {icon}",
		"format-icons": ["󰁻", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"]
	},
	"custom/pacman": {
		"format": "󰅢 {}",
		"interval": 30,
		"exec": "checkupdates | wc -l",
		"exec-if": "exit 0",
		"on-click": "kitty sh -c 'yay -Syu; echo Done - Press enter to exit; read'; pkill -SIGRTMIN+8 waybar",
		"signal": 8,
		"tooltip": false
	},
	"custom/expand": {
		"format": "",
		"tooltip": false
	},
	"custom/endpoint": {
		"format": "|",
		"tooltip": false
	},
	"group/expand": {
		"orientation": "horizontal",
		"drawer": {
			"transition-duration": 600,
			"transition-to-left": true,
			"click-to-reveal": true
		},
		"modules": [
			"custom/expand",
			"custom/colorpicker",
			"cpu",
			"memory",
			"temperature",
			"custom/endpoint"
		]
	},
	"custom/colorpicker": {
		"format": "{}",
		"return-type": "json",
		"interval": "once",
		"exec": "~/.config/waybar/scripts/colorpicker.sh -j",
		"on-click": "~/.config/waybar/scripts/colorpicker.sh",
		"signal": 1
	},
	"cpu": {
		"format": "{usage}% 󰻠",
		"tooltip": true,
		"on-click": "kitty --class btop btop"
	},
	"memory": {
		"format": "{}% 󰍛",
		"tooltip": true,
		"on-click": "kitty --class btop btop"
	},
	"temperature": {
		"critical-threshold": 80,
		"format": ""
	},
	"tray": {
		"icon-size": 14,
		"spacing": 20
	},
	"mpris": {
		"format": "{player_icon} {title}",
		"max-length": 35,
		// "rotate" : 10,
		"format-paused": "{status_icon} <i>{dynamic}</i>",
		"player-icons": {
			"default": "⏸",
			"mpv": "🎵"
		},
		"status-icons": {
			"paused": "▶"
		}
	}
}
